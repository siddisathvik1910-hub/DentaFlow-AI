{
  "name": "dentaflow-ai",
  "version": "1.0.0",
  "description": "DentaFlow AI - AI front-desk and booking agent for dental clinics (full-stack)",
  "main": "server/index.js",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js --reset",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test/engine.test.js test/agent.test.js test/web.test.js test/site.test.js",
    "check-links": "node scripts/check-links.js",
    "perf": "node scripts/perf.js",
    "check-contrast": "node scripts/check-contrast.js",
    "scan-secrets": "node scripts/scan-secrets.js",
    "audit-site": "npm run check-contrast && npm run scan-secrets && npm run check-links && npm run perf"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  }
}
